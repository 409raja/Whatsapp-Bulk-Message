
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  memberships         Membership[]
  contacts            Contact[]
  campaigns           Campaign[]
  mockDeliveries      MockCampaignDelivery[]
  liveDeliveries      LiveCampaignDelivery[]
  whatsappConnections WhatsAppConnection[]
  createdAt           DateTime             @default(now())
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  phone     String
  consent   Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

model Campaign {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  templateName String
  recipientIds Json     @default("[]")
  status       String   @default("DRAFT")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  mockDeliveries MockCampaignDelivery[]
  liveDeliveries LiveCampaignDelivery[]
  connectionId String?
  templateLanguage String?
  templateComponents Json?
  createdAt    DateTime @default(now())
}

model MockCampaignDelivery {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String
  contactId   String
  status      String   @default("QUEUED")
  mockId      String?
  lastError   String?
  attempts    Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([campaignId, contactId])
  @@index([tenantId, campaignId, status])
}

model WhatsAppConnection {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label              String
  wabaId             String
  phoneNumberId      String   @unique
  displayPhoneNumber String?
  status             String   @default("PENDING")
accessTokenEncrypted String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  liveDeliveries LiveCampaignDelivery[]
  @@index([tenantId])
}


model LiveCampaignDelivery {
  id           String @id @default(cuid())
  tenantId     String
  campaignId   String
  contactId    String
  connectionId String
  status       String @default("QUEUED")
  messageId    String? @unique
  attempts     Int @default(0)
  lastError    String?
  nextAttemptAt DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id])
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  @@unique([campaignId, contactId])
  @@index([tenantId, campaignId, status])
  @@index([connectionId, status])
}

model WhatsAppSignupSession {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  tenantId    String
  userId      String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}


